{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Burrow",
  "version": "0.1.0",
  "identifier": "dev.burrow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Burrow",
        "width": 760,
        "height": 520,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Developer utilities, one hotkey away",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] }
    }
  }
}
